---
// Shared shell for the three trust pages — /about, /privacy, /terms (plus their
// /zh/ counterparts). They differ only in copy, schema type, and revision date,
// so the page files stay thin and the layout lives here once.
//
// Copy comes from the `legal` block in src/i18n; the only interpolation is the
// About page's repo numbers, which are filled from the same committed GitHub
// snapshot the rest of the site reads (src/data/gh-stats.json) — the page can
// state a contributor count without anyone hand-maintaining the figure.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { ghStats } from '../lib/site';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  page: 'about' | 'privacy' | 'terms';
  /** Default-locale path, e.g. '/about/' — drives canonical, hreflang, and the language switcher. */
  path: string;
  /** schema.org @type for this page. */
  schemaType: 'AboutPage' | 'WebPage';
  /** ISO date this copy was last revised — rendered, and emitted as dateModified. */
  updated: string;
}
const { locale, page, path, schemaType, updated } = Astro.props;
const t = useTranslations(locale);
const lg = t.legal;
const c = lg[page];

const stats = await ghStats();
const starsK = (stats.stars / 1000).toFixed(1) + 'k';

const fill = (s: string) =>
  s
    .replace('{contributors}', String(stats.contributors))
    .replace('{stars}', stats.stars.toLocaleString('en-US'));

const title = c.seo.title;
const description = c.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const updatedLabel = new Date(updated).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: c.title.replace(/[.。]$/, ''),
  description,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  url: canonical,
  dateModified: updated,
  isPartOf: { '@type': 'WebSite', name: 'Open Multi-Agent', url: 'https://open-multi-agent.com' },
};
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={jsonLd} path={path}>
  <Nav current="legal" starsK={starsK} locale={locale} path={path} />
  <main>
    <section class="section">
      <div class="container container--narrow">
        <div class="section-head">
          <div class="eyebrow"><span class="idx">//</span> {c.eyebrow}</div>
          <h1 class="section-title">{c.title}</h1>
          <p class="section-sub">{c.lede}</p>
        </div>
        <div class="prose">
          {c.sections.map((s) => (
            <Fragment>
              <h2>{s.h}</h2>
              {s.body.map((p) => <p set:html={fill(p)} />)}
            </Fragment>
          ))}
          <p class="trust-updated">
            {lg.lastUpdated}: <time datetime={updated}>{updatedLabel}</time>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .trust-updated {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
