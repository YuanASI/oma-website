---
// Locale-aware enterprise-service trigger. Both locales link out to the
// matching YuanASI landing page (zh → homepage, en → /en) with UTM params
// resolved by yuanasiHref. Keeping the behavior in this one component prevents
// CTA drift between the nav, footer, homepage, and shared enterprise bands.
//
// Clicks are also reported to Baidu Analytics (百度统计) as events, so the
// enterprise CTA funnel is measurable per locale — the pageview-only
// Counterscale tag has no custom-event support. The anchor opens in a new tab,
// so the page (and the analytics script) stays alive long enough to send the
// event before the user navigates away.
import { yuanasiHref } from '../lib/site';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
  class?: string;
  style?: string;
}

const { locale = 'en', class: className, style } = Astro.props;
const trackClick = `window._hmt?.push(['_trackEvent', 'enterprise-cta', 'click', '${locale}'])`;
---

<a
  class={className}
  style={style}
  href={yuanasiHref(locale)}
  target="_blank"
  rel="noreferrer"
  onclick={trackClick}
>
  <slot />
</a>
