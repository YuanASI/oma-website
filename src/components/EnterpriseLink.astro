---
// Locale-aware enterprise-service trigger. Both locales link out to the
// matching YuanASI landing page (zh → homepage, en → /en) with UTM params
// resolved by yuanasiHref. Keeping the behavior in this one component prevents
// CTA drift between the nav, footer, homepage, and shared enterprise bands.
//
// Clicks are also reported to Counterscale — the same first-party, cookieless
// collector that counts pageviews — so the enterprise funnel sits in the dataset
// that already holds the traffic it came from. The event carries the name only;
// the locale split reads off the page path Counterscale records alongside it
// (`/…` vs `/zh/…`). The anchor opens in a new tab, so the page (and the
// tracker) stays alive long enough to send the event before the user leaves.
// The tracker is loaded `defer`, so every hop is optional-chained: a click
// before it lands is a lost measurement, never a broken link.
import { yuanasiHref } from '../lib/site';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
  class?: string;
  style?: string;
}

const { locale = 'en', class: className, style } = Astro.props;
const trackClick = "window.Counterscale?.trackEvent?.('enterprise-cta')";
---

<a
  class={className}
  style={style}
  href={yuanasiHref(locale)}
  target="_blank"
  rel="noreferrer"
  onclick={trackClick}
>
  <slot />
</a>
