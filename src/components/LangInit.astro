---
// First-touch language auto-routing for the neutral site root only. An explicit
// locale or deep link is user intent and must never be replaced by the browser
// language. On the first visit to `/`, zh-* → `/zh/`; anything else stays put.
//
// Why "once per browser": after the first run we set `oma-lang-seen` and bail on
// every later load regardless of outcome. That's what makes a manual switch
// sticky without us having to capture every switcher's click — the auto-route is
// a one-time first-touch convenience, not a standing redirect.
//
// The target URL still comes from the page's own alternate link, so routing
// remains coupled to a real localized counterpart rather than a guessed path.
---
<script is:inline>
  (() => {
    try {
      // Never auto-route search crawlers. They render with an en-locale UA and a
      // fresh (empty) localStorage on every fetch, so the "once per browser" gate
      // below can't hold them: they'd be bounced off every /zh/ page and Google
      // would log it as "Page with redirect" and drop the Chinese page from its
      // index. Declining the redirect for bots is not cloaking — crawler and human
      // get the identical page; we only skip *redirecting* the crawler.
      if (/bot|crawl|spider|slurp|mediapartners/i.test(navigator.userAgent)) return;

      // `/zh/`, documentation routes, and every other explicit deep link win.
      if (location.pathname !== '/') return;

      // One shot per browser: if we've already evaluated once, never interfere
      // again — this is what keeps a later manual language switch from bouncing.
      if (localStorage.getItem('oma-lang-seen')) return;
      localStorage.setItem('oma-lang-seen', '1');

      const langs = navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language || 'en'];
      const want = langs.some((l) => /^zh\b/i.test(l)) ? 'zh' : 'en';

      const path = location.pathname;
      const current = 'en';
      if (current === want) return;

      // Counterpart URL from the hreflang alternate the page already emits; it's
      // present only when that localized page actually exists, so we never 404.
      const sel = want === 'zh'
        ? 'link[rel="alternate"][hreflang="zh-CN"]'
        : 'link[rel="alternate"][hreflang="en"]';
      const href = document.querySelector(sel)?.getAttribute('href');
      if (!href) return;

      const dest = new URL(href, location.origin).pathname;
      if (dest === path) return;
      location.replace(dest + location.search + location.hash);
    } catch { /* storage blocked or no match — stay on the current page */ }
  })();
</script>
