---
// TaskNode — the signature DAG task node. Mirrors the post-run dashboard:
// #NODE id, title, status line with duration, and role + state badges.
import Badge from './Badge.astro';
import { useTranslations, type Locale } from '../../i18n';

type Status = 'done' | 'running' | 'queued' | 'failed' | 'skipped';

interface Props {
  id?: string;
  title?: string;
  status?: Status;
  duration?: string | null;
  role?: string | null;
  selected?: boolean;
  compact?: boolean;
  locale?: Locale;
  /**
   * Render the queued / running / done variants of the mark, status line and
   * badge alongside the served status, so a client script can move the node
   * between them by setting `data-status` — no re-render, no string of
   * localized labels to ship separately. `replayId` is how that script finds
   * the node (the same captured task can appear in the desktop and the mobile
   * DAG). With JS off the served status is the only one that is visible, so
   * the markup degrades to exactly what a plain TaskNode renders.
   */
  replayId?: string | null;
  /**
   * Reserve two title lines. Set it on nodes that stand side by side, so a
   * one-line title next to a two-line one still lines its status and badges up
   * with its neighbour's; a node that is alone on its row does not pay for the
   * blank line it would never use.
   */
  alignTitle?: boolean;
}
const {
  id = '#NODE_001',
  title = 'Untitled task',
  status = 'done',
  duration = null,
  role = null,
  selected = false,
  compact = false,
  locale = 'en',
  replayId = null,
  alignTitle = false,
} = Astro.props;
const t = useTranslations(locale);

const STATUS_STYLE: Record<string, { color: string }> = {
  done:    { color: 'var(--oma-accent)' },
  running: { color: 'var(--oma-warning)' },
  queued:  { color: 'var(--oma-fg-2)' },
  failed:  { color: 'var(--oma-danger)' },
  skipped: { color: 'var(--oma-fg-3)' },
};
const s = STATUS_STYLE[status] ?? STATUS_STYLE.done;
const label = t.taskStatus[status as Status] ?? t.taskStatus.done;
const MARK: Record<string, string> = { done: '✓', failed: '✕', running: '◓', queued: '○', skipped: '○' };
const mark = MARK[status] ?? MARK.done;
// Only the three states a replay moves through get an alternate variant; a
// captured failure or skip is a served fact, not a frame of an animation.
const REPLAY_STATES: Status[] = ['queued', 'running', 'done'];
---

<div
  class={`ds-tasknode${selected ? ' is-selected' : ''}${compact ? ' is-compact' : ''}${replayId ? ' is-replayable' : ''}${alignTitle ? ' is-title-aligned' : ''}`}
  data-status={replayId ? status : undefined}
  data-replay-id={replayId ?? undefined}
>
  <div class="ds-tasknode__top">
    <span class="ds-tasknode__id">{id}</span>
    {replayId ? (
      <span class="ds-tasknode__mark">
        {REPLAY_STATES.map((st) => (
          <span data-when={st} style={`color:${STATUS_STYLE[st].color}`}>{MARK[st]}</span>
        ))}
      </span>
    ) : (
      <span class="ds-tasknode__mark" style={`color:${s.color}`}>{mark}</span>
    )}
  </div>
  <div class="ds-tasknode__title">{title}</div>
  {replayId ? (
    <div class="ds-tasknode__status">{t.taskStatus.statusPrefix}{REPLAY_STATES.map((st) => (
      <span data-when={st} style={`color:${STATUS_STYLE[st].color};font-weight:500`}>{t.taskStatus[st]}</span>
    ))}{duration && <span data-when="done">{` (${duration})`}</span>}</div>
  ) : (
    <div class="ds-tasknode__status">{t.taskStatus.statusPrefix}<span style={`color:${s.color};font-weight:500`}>{label}</span>{duration ? ` (${duration})` : ''}</div>
  )}
  {role && (
    <div class="ds-tasknode__badges">
      <Badge tone="neutral">{role}</Badge>
      {replayId ? (
        <Fragment>
          <span data-when="done"><Badge tone="accent">{t.taskStatus.badge.stable}</Badge></span>
          <span data-when="running"><Badge tone="warning" dot>{t.taskStatus.badge.live}</Badge></span>
        </Fragment>
      ) : (
        <Fragment>
          {status === 'done' && <Badge tone="accent">{t.taskStatus.badge.stable}</Badge>}
          {status === 'running' && <Badge tone="warning" dot>{t.taskStatus.badge.live}</Badge>}
          {status === 'failed' && <Badge tone="danger">{t.taskStatus.badge.error}</Badge>}
        </Fragment>
      )}
    </div>
  )}
</div>

<style>
  .ds-tasknode {
    width: 100%; min-width: 0;
    background: var(--oma-bg-1); border: 1px solid var(--oma-border-1);
    border-radius: var(--radius-md); padding: 14px 16px;
    font-family: var(--font-sans); box-shadow: none;
    transition: border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }
  .ds-tasknode:hover { border-color: var(--oma-border-2); box-shadow: var(--shadow-md); }
  .ds-tasknode.is-selected { border-color: var(--oma-accent); box-shadow: var(--shadow-accent-glow); }
  .ds-tasknode__top { display: flex; align-items: center; justify-content: space-between; }
  .ds-tasknode__id { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--oma-fg-2); }
  .ds-tasknode__mark { font-size: 13px; line-height: 1; }
  .ds-tasknode__title { color: var(--oma-fg-0); font-size: 15px; font-weight: 600; line-height: 1.3; margin: 8px 0 6px; }
  .ds-tasknode__status { font-family: var(--font-mono); font-size: 11px; color: var(--oma-fg-2); }
  .ds-tasknode__badges { display: flex; gap: 6px; margin-top: 10px; }
  .ds-tasknode.is-compact { padding: 9px 12px; }
  .ds-tasknode.is-compact .ds-tasknode__id,
  .ds-tasknode.is-compact .ds-tasknode__status { font-size: 10px; }
  /* Captured task titles are a full clause ("Attack surface review:
     authentication, endpoints, and trust boundaries"), so in the two-up
     parallel row they wrap. Reserve two lines whether the title needs one or
     two, so nodes standing side by side keep their status lines and badges on
     the same baseline; clamp at two so a longer capture cannot push one card
     taller than its neighbour. */
  .ds-tasknode.is-compact .ds-tasknode__title {
    margin: 4px 0; font-size: 13px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ds-tasknode.is-compact.is-title-aligned .ds-tasknode__title { min-height: calc(2 * 1.3 * 13px); }
  .ds-tasknode.is-compact .ds-tasknode__badges { margin-top: 6px; }

  /* Replay variants: the served status is the visible one, the other two wait
     for a client script to flip data-status. */
  .ds-tasknode.is-replayable [data-when] { display: none; }
  .ds-tasknode.is-replayable[data-status='queued'] .ds-tasknode__mark [data-when='queued'],
  .ds-tasknode.is-replayable[data-status='running'] .ds-tasknode__mark [data-when='running'],
  .ds-tasknode.is-replayable[data-status='done'] .ds-tasknode__mark [data-when='done'],
  .ds-tasknode.is-replayable[data-status='queued'] .ds-tasknode__status [data-when='queued'],
  .ds-tasknode.is-replayable[data-status='running'] .ds-tasknode__status [data-when='running'],
  .ds-tasknode.is-replayable[data-status='done'] .ds-tasknode__status [data-when='done'] { display: inline; }
  .ds-tasknode.is-replayable[data-status='done'] .ds-tasknode__badges [data-when='done'],
  .ds-tasknode.is-replayable[data-status='running'] .ds-tasknode__badges [data-when='running'] { display: inline-flex; }
</style>
