---
// Append the trust-page links the custom pages carry in their own footer — the
// docs are the bulk of the site's URLs, so About/Privacy/Terms have to be
// reachable from here too. Starlight's own footer content (pagination,
// last-updated) stays untouched.
import Default from '@astrojs/starlight/components/Footer.astro';
import { useTranslations, localizePath, type Locale } from '../i18n';

const locale: Locale = Astro.locals.starlightRoute.lang === 'zh-CN' ? 'zh' : 'en';
const t = useTranslations(locale);
const L = (p: string) => localizePath(p, locale);
---

<Default><slot /></Default>
<div class="docs-legal">
  <a href={L('/about/')}>{t.footer.legal.about}</a>
  <a href={L('/privacy/')}>{t.footer.legal.privacy}</a>
  <a href={L('/terms/')}>{t.footer.legal.terms}</a>
</div>

<style>
  .docs-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
  }
  .docs-legal a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .docs-legal a:hover {
    color: var(--sl-color-white);
  }
</style>
