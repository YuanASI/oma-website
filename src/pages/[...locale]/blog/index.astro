---
// /blog and /zh/blog — the post index. One template, both locales (the [...locale]
// rest param is empty for en at the root, `zh` for /zh/). Lists the `blog`
// collection filtered to the current locale, newest-first; the locale-aware <head>
// comes from BaseLayout. The zh index shows only posts that have a translation.
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../../../styles/tokens.css';
import '../../../styles/landing.css';
import '../../../styles/blog.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/ds/Card.astro';
import Badge from '../../../components/ds/Badge.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import EnterpriseCta from '../../../components/EnterpriseCta.astro';
import EnterpriseHeadCta from '../../../components/EnterpriseHeadCta.astro';
import { ghStats } from '../../../lib/site';
import { getCollection } from 'astro:content';
import { localeStaticPaths, toLocale, useTranslations, localizePath, blogLocaleOf, blogSlugOf } from '../../../i18n';

export function getStaticPaths() { return localeStaticPaths(); }
const locale = toLocale(Astro.params.locale);
const bt = useTranslations(locale).blog;
const L = (p: string) => localizePath(p, locale);

const stats = await ghStats();
const starsK = (stats.stars / 1000).toFixed(1) + 'k';

const posts = (await getCollection('blog'))
  .filter((p) => blogLocaleOf(p.id) === locale)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const contentTypeLabels = {
  application: bt.contentTypes.application,
  'field-note': bt.contentTypes.fieldNote,
  'decision-guide': bt.contentTypes.decisionGuide,
  engineering: bt.contentTypes.engineering,
  release: bt.contentTypes.release,
};
// Evidence kind and its scope note live on the post page, where the note gives
// the kind its meaning. On a card the label alone repeated once per post
// without adding much to the decision to open it.
const primarySections = [
  { type: 'application', copy: bt.sections.application },
  { type: 'field-note', copy: bt.sections.fieldNote },
  { type: 'decision-guide', copy: bt.sections.decisionGuide },
] as const;
const postsFor = (type: (typeof primarySections)[number]['type']) =>
  posts
    .filter((post) => post.data.contentType === type)
    .sort((a, b) =>
      Number(b.data.featured) - Number(a.data.featured)
      || b.data.pubDate.getTime() - a.data.pubDate.getTime());
// Resolved before render so the section directly under the hero can tighten
// its top padding (`is-first`), whichever pillar that turns out to be.
const pillars = primarySections
  .map((section) => ({ ...section, posts: postsFor(section.type) }))
  .filter((section) => section.posts.length > 0);
const archivePosts = posts.filter((post) =>
  post.data.contentType === 'engineering' || post.data.contentType === 'release');
const fmtDate = (d: Date) =>
  d.toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const title = bt.seo.title;
const description = bt.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'Open Multi-Agent', url: 'https://open-multi-agent.com' },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.pubDate.toISOString(),
    url: new URL(L(`/blog/${blogSlugOf(p.id)}/`), Astro.site).href,
  })),
};
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={jsonLd} path="/blog/">
  {locale === 'en' && (
    <Fragment slot="head">
      <link rel="alternate" type="application/rss+xml" title="Open Multi-Agent blog" href="/rss.xml" />
    </Fragment>
  )}

  <Nav current="blog" starsK={starsK} locale={locale} path="/blog/" />
  <main>
    <section class="section blog-hero">
      <div class="container">
        <div class="hero-head-row">
          <div class="section-head">
            <div class="eyebrow"><span class="idx">//</span> {bt.eyebrow}</div>
            <h1 class="section-title">{bt.title}</h1>
            <p class="section-sub">{bt.lede}</p>
          </div>
          <EnterpriseHeadCta locale={locale} />
        </div>
      </div>
    </section>

    {pillars.map((section, sectionIndex) => {
      const sectionPosts = section.posts;

      return (
        <section
          class={`section blog-pillar${sectionIndex === 0 ? ' is-first' : ''}`}
          aria-labelledby={`blog-${section.type}`}
        >
          <div class="container">
            <div class="section-head">
              <div class="eyebrow"><span class="idx">{section.copy.index}</span> {section.copy.eyebrow}</div>
              <h2 class="section-title" id={`blog-${section.type}`}>{section.copy.title}</h2>
              <p class="section-sub">{section.copy.lede}</p>
            </div>
            <div class="blog-editorial-grid">
              {sectionPosts.map((p, index) => (
                <a class={`blog-card-link${index === 0 ? ' is-feature' : ''}`} href={L(`/blog/${blogSlugOf(p.id)}/`)}>
                  <Card padding="lg" interactive class="blog-editorial-card">
                    <div class="blog-card-kicker">
                      <Badge tone="accent">{contentTypeLabels[p.data.contentType]}</Badge>
                      <span class="blog-card-meta">
                        <time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time>
                        {' · '}{p.data.readingMinutes} {bt.minRead}
                      </span>
                    </div>
                    <h3 class="blog-card-title">{p.data.title}</h3>
                    <p class="blog-card-desc">{p.data.description}</p>
                    {(p.data.industries.length > 0 || p.data.useCases.length > 0) && (
                      <div class="blog-card-tags">
                        {[...p.data.industries, ...p.data.useCases].slice(0, 3).map((tag) => <Badge tone="neutral">{tag}</Badge>)}
                      </div>
                    )}
                  </Card>
                </a>
              ))}
            </div>
          </div>
        </section>
      );
    })}

    {archivePosts.length > 0 && (
      <section
        class={`section blog-archive${pillars.length === 0 ? ' is-first' : ''}`}
        aria-labelledby="blog-archive"
      >
        <div class="container">
          <div class="section-head">
            <div class="eyebrow"><span class="idx">{bt.sections.archive.index}</span> {bt.sections.archive.eyebrow}</div>
            <h2 class="section-title" id="blog-archive">{bt.sections.archive.title}</h2>
            <p class="section-sub">{bt.sections.archive.lede}</p>
          </div>
          <div class="blog-archive-list">
            {archivePosts.map((p) => (
              <a class="blog-archive-row" href={L(`/blog/${blogSlugOf(p.id)}/`)}>
                <span class="kind">
                  <Badge tone={p.data.contentType === 'release' ? 'info' : 'neutral'}>
                    {contentTypeLabels[p.data.contentType]}
                  </Badge>
                </span>
                <h3 class="name">{p.data.title}</h3>
                <span class="meta">
                  <time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time>
                  {' · '}{p.data.readingMinutes} {bt.minRead}
                </span>
                <span class="arr" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <EnterpriseCta locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
