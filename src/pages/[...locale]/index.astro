            <div class="cmd-wrap">
              <button type="button" class="cmd" data-cmd={HERO_INSTALL} data-copied={l.copied} data-failed={l.copyFailed} data-landing-event="copy-command-final">
                <span class="sr-only">{l.copy} </span><span class="prompt">$</span><span class="text">{HERO_INSTALL}</span><span class="copy" aria-hidden="true" title={l.copy}><svg class="copy-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><svg class="check-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
