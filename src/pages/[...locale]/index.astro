---
// OMA landing page (open-multi-agent.com homepage).
// Ported 1:1 from the Claude Design system (bfaf7892) export, with the
// fact-check corrections agreed in the handoff:
//   • §3 global nav (Product ▾ open-multi-agent + oma-forge / Docs / Architecture / Examples / Showcase / Blog / GitHub)
//   • Production-proof cases rewritten from the OMA README ecosystem section
//     (temodar = security · on Docker Hub; Engram + @agentsonar = integrations)
//   • team.ts code uses the REAL published API (AgentConfig.name, real tool names, methods)
//   • Live GitHub stats fetched at build time (no hard-coded precise numbers)
//   • "see code" links point to real cookbook examples in the repo
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/tokens.css';
import '../../styles/landing.css';
// Landing-only blocks (hero DAG visual, FAQ, compact IA, endorsement). Split
// out of landing.css so the other ~20 custom pages stop downloading them; see
// the header of home.css for what belongs in which file.
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ds/Badge.astro';
import Card from '../../components/ds/Card.astro';
import heroRunEn from '../../data/hero-run.json';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import EnterpriseLink from '../../components/EnterpriseLink.astro';
import { REPO, NPM, GITHUB_ORG, MAINTAINER_GITHUB, MAINTAINER_DEVTO, CONTACT_EMAIL, WHATSAPP, ghStats, yuanasiHref } from '../../lib/site';
import { SHOWCASE } from '../../lib/showcase';
import { detailSlugs, getFeaturedUseCases } from '../../lib/examples';
import { computeReplaySchedule } from '../../lib/hero-replay';
import { localeStaticPaths, toLocale, useTranslations, localizePath } from '../../i18n';

export function getStaticPaths() { return localeStaticPaths(); }
const locale = toLocale(Astro.params.locale);
const t = useTranslations(locale);
const l = t.landing;
const L = (p: string) => localizePath(p, locale);

// Hero renders a REAL captured runTeam() DAG. zh uses a Chinese-goal capture
// (src/data/hero-run.zh.json) when it exists; until that capture lands, zh falls
// back to the English run so the build stays green. Never hand-edit the JSON to
// fake a localized run (PRD §4.1 ①).
const heroRunZhFiles = import.meta.glob('../../data/hero-run.zh.json', { eager: true, import: 'default' });
const heroRun = (locale === 'zh' ? (heroRunZhFiles['../../data/hero-run.zh.json'] ?? heroRunEn) : heroRunEn) as typeof heroRunEn;

// REPO / NPM constants and ghStats() now live in ../../lib/site (shared with the
// Nav/Footer components and the /examples page). FORGE is only used by Nav.
const stats = await ghStats();
const fmt = (n: number) => n.toLocaleString('en-US');
// Soft counts for the hero trust strip. `0` is a real count, so it can never
// stand in for "unknown" — a cell whose number is missing or non-finite is
// dropped from the strip rather than rendered as a zero.
const count = (n: number | undefined) => (typeof n === 'number' && Number.isFinite(n) ? n : null);
const trustContributors = count(stats.contributors);
const trustReleases = count(stats.releaseCount);
const starsK = (stats.stars / 1000).toFixed(1) + 'k';

// The copyable command behind both terminal chips (hero + closing CTA). One
// constant so the two can never drift apart, which is exactly what happened
// while each carried its own literal.
//
// It installs the runtime into a project the reader already has, rather than
// scaffolding a new one: the homepage's job is the first step for someone
// evaluating OMA, and they are far likelier to have a TypeScript service open
// than to want a fresh directory. The zero-project path is still one click
// away — that is what the quick start beneath the chip is for.
const HERO_INSTALL = 'npm install @open-multi-agent/core';

// ── Hero right-visual: a REAL captured runTeam() DAG. The nodes below are
//    rendered from src/data/hero-run.json, produced by a real provider run
//    (scripts/capture-hero-dag.mjs) — no hand-built mockup (PRD §4.1 ①). The
//    snippet's goal is the exact goal that produced the DAG shown. ──
// The panel's top block is the input, always open: the code that produced the
// run below it, with the captured goal as the string literal it really is.
// Newlines in the localized capture collapse to spaces only for display; the
// underlying run data and every task row remain unchanged. The goal line shows
// the goal's first sentence, ellipsized to the excerpt's column budget — the
// captured goal in full is that line's title attribute, never paraphrased.
const heroGoalSummary = (() => {
  const flat = heroRun.goal.replace(/\s+/g, ' ').trim();
  return flat.match(/^[\s\S]*?[.。！？!?](?=\s|$)/)?.[0] ?? flat;
})();

// Group the captured tasks into dependency levels (depth = longest path from a
// root). Same-depth tasks ran in parallel; this drives the run-log grouping
// below (a bracket around a level of more than one, a `↳ after n` prefix on a
// row that waited).
const heroById = new Map(heroRun.tasks.map((t) => [t.id, t]));
const heroDepthCache = new Map<string, number>();
const heroDepth = (t: (typeof heroRun.tasks)[number]): number => {
  const cached = heroDepthCache.get(t.id);
  if (cached !== undefined) return cached;
  const deps = (t.dependsOn ?? []).filter((id) => heroById.has(id));
  const d = deps.length === 0 ? 0 : 1 + Math.max(...deps.map((id) => heroDepth(heroById.get(id)!)));
  heroDepthCache.set(t.id, d);
  return d;
};
const heroMaxDepth = Math.max(...heroRun.tasks.map(heroDepth));
const heroLevels = Array.from({ length: heroMaxDepth + 1 }, (_, d) =>
  heroRun.tasks.filter((t) => heroDepth(t) === d),
);
const heroStatusMap: Record<string, 'done' | 'running' | 'queued' | 'failed' | 'skipped'> = {
  completed: 'done', in_progress: 'running', pending: 'queued', failed: 'failed', skipped: 'skipped', blocked: 'queued',
};
const heroDur = (ms: number | null) => (ms == null ? null : (ms / 1000).toFixed(1) + 's');
const heroNodeId = (id: string) => '#' + id.slice(0, 8);
const heroWallS = Math.round(heroRun.wallMs / 1000);
// A run-log row shows the clause before the first colon — the captured titles
// are all "<what was reviewed>: <the specifics>", and the specifics are what
// makes them wrap. The full title is never dropped: it stays in the row's
// `title` attribute and in visually-hidden text, so a screen reader and a
// hover both get the captured string verbatim. Both colons are matched: the
// zh capture writes the full-width one.
const heroShortTitle = (title: string) => title.split(/[:：]/)[0];

// ── Panel footer receipt. Every field is read straight out of the capture, so
//    a reader can check the line against src/data/hero-run.json. It has to hold
//    one line at the panel's ~564px, which is what the receipt costs: the run's
//    token total and capture date live in the capture file rather than here. ──
const heroRunShort = heroRun.runId.slice(0, 8);

// ── Panel replay. computeReplaySchedule derives a start/end for every task
//    from that task's own captured durationMs and dependsOn edges (see
//    src/lib/hero-replay.ts for the full model and scripts/hero-replay.test.mjs
//    for the arithmetic). The schedule is computed here, at build time, and
//    handed to the browser as data; the client script only walks it. Without
//    JS the DAG below stays exactly as it is served — every task completed. ──
const heroReplay = computeReplaySchedule(heroRun.tasks, heroRun.wallMs);

// ── Panel input layer: a faithful abbreviation of the capture script's own
//    calls. Every identifier below appears in scripts/capture-hero-dag.mjs —
//    the constructor, createTeam with its agents array, and the runTeam that
//    produced the DAG underneath. Where the script has more (the other three
//    agents, their prompts) the excerpt says so with an ellipsis rather than
//    silently dropping it, and nothing the script does not call is shown. ──
const HERO_CAPTURE_SCRIPT = 'https://github.com/YuanASI/oma-website/blob/main/scripts/capture-hero-dag.mjs';
// The goal line carries the capture's own goal as the literal it is in the
// script. It is ellipsized to a column budget that keeps the whole line inside
// the widest of the other six (69 columns), so the block never scrolls
// sideways in the panel; the captured goal in full is that line's title. CJK
// counts double — the zh capture's goal is Chinese and this is a fixed pitch
// grid — and the ellipsis is inside the budget, never added on top of it.
const HERO_GOAL_COLS = 50;
const heroCols = (s: string) =>
  [...s].reduce((n, ch) => n + (/[\u2e80-\u9fff\uff01-\uff60]/.test(ch) ? 2 : 1), 0);
const heroGoalLiteral = (() => {
  if (heroCols(heroGoalSummary) <= HERO_GOAL_COLS) return heroGoalSummary;
  let out = '';
  for (const ch of heroGoalSummary) {
    if (heroCols(out + ch) > HERO_GOAL_COLS - 1) break;
    out += ch;
  }
  // Cut back to a word boundary only when the cut landed inside a word: the
  // Latin capture separates words with spaces, the Chinese one does not.
  const next = heroGoalSummary.slice(out.length, out.length + 1);
  if (/\S/.test(next) && !/[\u2e80-\u9fff]/.test(next) && out.includes(' ')) {
    out = out.slice(0, out.lastIndexOf(' '));
  }
  return out.trimEnd() + '…';
})();
const HERO_EXCERPT: { text: string; title?: string }[] = [
  { text: 'const oma = new OpenMultiAgent({ maxConcurrency: 3 })' },
  { text: "const team = oma.createTeam('security-analysis-team', { agents: [" },
  { text: "  { name: 'attack-surface-reviewer', systemPrompt: '…', maxTurns: 2 }," },
  { text: '  // … data-security-reviewer, supply-chain-reviewer, synthesizer' },
  { text: '] })' },
  { text: `const goal = '${heroGoalLiteral}'`, title: heroRun.goal },
  { text: 'const result = await oma.runTeam(team, goal)' },
];
// Build-time tokenizer, deliberately tiny: this excerpt is six fixed lines, not
// arbitrary user code, so it needs strings, the three keywords it actually
// uses, numbers, and a whole-line comment — nothing more.
const heroTok = (line: string): { t: string; c: string | null }[] => {
  const comment = line.indexOf('//');
  if (comment >= 0) {
    return [{ t: line.slice(0, comment), c: null }, { t: line.slice(comment), c: 'cmt' }].filter((p) => p.t);
  }
  return line
    .split(/('[^']*'|\b(?:const|new|await)\b|\b\d+\b)/g)
    .filter(Boolean)
    .map((t) => ({ t, c: t.startsWith("'") ? 'str' : /^\d+$/.test(t) ? 'num' : /^(const|new|await)$/.test(t) ? 'kw' : null }));
};

// ── Production proof uses the three "Built with OMA" apps from the shared
//    showcase list. The full inventory, integrations, and practitioner spotlight
//    remain on /showcase; the homepage keeps only three representative projects. ──
const CASES = SHOWCASE.filter((c) => ['temodar-agent', 'PR-Copilot', 'StuFlow'].includes(c.pkg));
const scEntries = t.showcase.entries;
const caseTr = (c: (typeof SHOWCASE)[number]) => scEntries[c.pkg] ?? { desc: c.desc, tag: c.tag, status: c.status };

// Section copy lives in the per-locale dictionary (src/i18n); the markup below
// renders it via `l`. Every API name / code identifier inside the copy stays
// verbatim. Copy here describes the published release only — never something
// that exists on the framework's main branch but has not shipped. For the
// release this and the rest of the capability copy was last read against, see
// CAPABILITY_COPY_REVIEWED_FOR in src/i18n/en.ts; that constant is the single
// sign-off, so this comment does not carry a version of its own.
//
// Six cards, one per pillar of the framework README's "Why OMA" section — the
// homepage tells the README's story, so a release that changes the README's
// pillars owes this list a matching edit, and one that does not can leave it
// alone. The per-card limits the copy must respect are in the dictionary.
const WHY = l.why;

// The first three featured Use-case Recipes come from catalog featuredOrder.
// URLs resolve from the synchronized inventory; localized editorial copy stays
// keyed by stable catalog id so ordering cannot pair the wrong claim and source.
const buildDetailSlugs = detailSlugs();
const buildCopy = l.builds as Record<string, (typeof l.builds)[keyof typeof l.builds]>;
const BUILDS = getFeaturedUseCases().flatMap((example) => {
  const copy = buildCopy[example.id];
  if (!copy) return [];
  const internal = buildDetailSlugs.has(example.id);
  return [{
    ...copy,
    slug: example.id,
    code: internal ? L(`/examples/${example.id}/`) : example.href,
    external: !internal,
  }];
});

// Five questions, read as an evaluator rather than an implementer: what the
// runtime does with a goal, whether it runs on the models you already have,
// what happens when something fails, how spend is capped, and who delivers it
// when there is no engineering team. Tool exposure, streaming, the "off the
// rails" controls, and the Claude Code comparison stay in the pool — card 06
// already says default-deny, card 03 covers the gates, and /compare carries
// the Claude Code page.
//
// The enterprise answer carries its channels as links so a reader can act on
// it. The yuanasi.com link keeps the same campaign parameters as every other
// enterprise CTA on the site; WhatsApp renders only when a number is set.
const ENTERPRISE_LINKS = [
  { label: 'yuanasi.com', href: yuanasiHref(locale) },
  { label: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
  ...(WHATSAPP ? [{ label: 'WhatsApp', href: WHATSAPP }] : []),
];
type Faq = { q: string; a: string; links?: { label: string; href: string }[] };
const FAQS: Faq[] = [l.faqs[0], l.faqs[1], l.faqs[3], l.faqs[5], { ...l.faqs[8], links: ENTERPRISE_LINKS }];

const title = l.seo.title;
const description = l.seo.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// ── JSON-LD structured data (PRD §4.6 GEO) ──
// SoftwareApplication + Organization + FAQPage in one @graph. The FAQPage
// reuses the FAQS array above verbatim, so the markup always matches the
// visible FAQ section (Google requires structured-data ↔ on-page parity).
// No aggregateRating: there is no real rating data, and inventing one would
// violate red-line §5.1. `offers` (free/MIT) makes the entry rich-eligible.
const orgId = new URL('/#organization', Astro.site).href;
// The maintainer the /about page names, as a node the software and the company
// can both point at. `sameAs` carries only accounts that can be checked from
// outside — the GitHub user that owns the org and the dev.to profile the blog
// cross-posts to.
const personId = new URL('/#maintainer', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // The homepage's site-level entity. Inner pages already declare
      // `isPartOf` a WebSite; this is the node they point back to. No
      // SearchAction — site search is client-side (Pagefind) with no query URL
      // to declare, and claiming one Google cannot execute would be a fiction.
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: 'Open Multi-Agent',
      alternateName: 'OMA',
      url: new URL('/', Astro.site).href,
      inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'YuanASI',
      alternateName: '元定义科技',
      url: 'https://yuanasi.com',
      logo: new URL('/logo-mark-dark.svg', Astro.site).href,
      // Same address the /about page publishes — one contact fact, two places.
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        email: 'jack@yuanasi.com',
        url: 'https://yuanasi.com',
        availableLanguage: ['en', 'zh-CN'],
      },
      founder: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Jack Chen',
      url: MAINTAINER_GITHUB,
      affiliation: { '@id': orgId },
      sameAs: [MAINTAINER_GITHUB, MAINTAINER_DEVTO],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': new URL('/#software', Astro.site).href,
      name: 'Open Multi-Agent',
      alternateName: ['OMA', '@open-multi-agent/core'],
      description,
      inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Node.js 20+',
      url: new URL('/', Astro.site).href,
      downloadUrl: NPM,
      codeRepository: REPO,
      programmingLanguage: 'TypeScript',
      license: 'https://opensource.org/licenses/MIT',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': orgId },
      publisher: { '@id': orgId },
      maintainer: { '@id': personId },
      sameAs: [REPO, NPM, GITHUB_ORG],
    },
    {
      '@type': 'FAQPage',
      '@id': new URL('/#faq', Astro.site).href,
      mainEntity: FAQS.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={jsonLd} path="/">
  <!-- ── Nav (§3 global) — shared component ── -->
  <Nav current="home" starsK={starsK} locale={locale} path="/" />

    <main>
      <!-- ── 1. Hero ── -->
      <header class="hero" id="top">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow"><span class="idx">//</span> {l.hero.eyebrow}</div>
            <h1>{l.hero.h1}<span class="accent">{l.hero.h1Accent}</span></h1>
            <p class="hero-sub" set:html={l.hero.subtitle}></p>
            <div class="hero-cta">
              <div class="cmd-wrap">
                <button type="button" class="cmd" data-cmd={HERO_INSTALL} data-copied={l.copied} data-failed={l.copyFailed} data-landing-event="copy-command-hero">
                  <span class="sr-only">{l.copy} </span><span class="prompt">$</span><span class="text">{HERO_INSTALL}</span><span class="copy" aria-hidden="true" title={l.copy}><svg class="copy-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><svg class="check-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg></span>
                </button>
                <span class="copy-feedback" aria-live="polite"></span>
              </div>
            </div>
            <div class="hero-trust" aria-label={l.hero.trust.stars}>
              <a href={REPO} target="_blank" rel="noreferrer"><b>★ {fmt(stats.stars)}</b><span>{l.hero.trust.stars}</span></a>
              {trustContributors !== null && <a href={REPO + '/graphs/contributors'} target="_blank" rel="noreferrer"><b>{fmt(trustContributors)}</b><span>{l.hero.trust.contributors}</span></a>}
              {trustReleases !== null && <a href={REPO + '/releases'} target="_blank" rel="noreferrer"><b>{fmt(trustReleases)}</b><span>{l.hero.trust.releases}</span></a>}
              <span><b>MIT</b><span>{l.hero.trust.license}</span></span>
            </div>
          </div>
          <div>
            <div class="io-panel" data-hero-replay={JSON.stringify(heroReplay)}>
              {/* Input: the code that produced the run below, open. An
                  editor tab names the file it abbreviates and links to the
                  whole of it; the goal is the string literal it is in the
                  script, ellipsized to the block's width with the captured
                  goal in full on the line's title. */}
              <div class="io-code">
                <div class="io-tab">
                  <span class="io-tab-name">team.ts</span>
                  <a class="io-cap-link" href={HERO_CAPTURE_SCRIPT} target="_blank" rel="noreferrer"><span>{l.hero.fullScript}</span><span class="arrow" aria-hidden="true">→</span></a>
                </div>
                <pre class="io-excerpt" tabindex="0">{HERO_EXCERPT.map((line) => <div title={line.title}>{heroTok(line.text).map((tok) => (tok.c ? <span class={tok.c}>{tok.t}</span> : tok.t))}</div>)}</pre>
              </div>
              <div class="io-connector">{l.hero.decomposesInto}</div>
              {/* The run, one row per captured task: status glyph, node id,
                  title, the agent it was assigned to, and its own duration. A
                  level of more than one task ran in parallel and is bracketed;
                  a task that waited carries how many it waited on. */}
              <div class="run-log">
                {heroLevels.map((level) => {
                  const rows = level.map((task) => {
                    const deps = (task.dependsOn ?? []).filter((id) => heroById.has(id));
                    return (
                      <div class="run-row" data-status={heroStatusMap[task.status] ?? 'done'} data-replay-id={task.id}>
                        <span class="run-glyph" aria-hidden="true"><span data-when="queued">○</span><span data-when="running">●</span><span data-when="done">✓</span></span>
                        <span class="sr-only"><span data-when="queued">{t.taskStatus.queued}</span><span data-when="running">{t.taskStatus.running}</span><span data-when="done">{t.taskStatus.done}</span></span>
                        <code class="run-id">{heroNodeId(task.id)}</code>
                        <span class="run-title" title={task.title}>
                          {deps.length > 0 && (
                            <span class="run-after"><span aria-hidden="true">↳ </span>{l.hero.afterDeps.replace('{count}', String(deps.length))}</span>
                          )}
                          <span class="run-name" aria-hidden="true">{heroShortTitle(task.title)}</span>
                          <span class="sr-only">{task.title}</span>
                        </span>
                        <span class="run-who">{task.assignee}</span>
                        <span class="run-dur" data-when="done">{heroDur(task.durationMs)}</span>
                      </div>
                    );
                  });
                  return level.length > 1 ? (
                    <div class="run-group">
                      <span class="run-group-tag">{l.hero.parallel} ×{level.length}</span>
                      {rows}
                    </div>
                  ) : rows;
                })}
              </div>
              {/* The receipt: one line, every field read out of the capture.
                  It has to hold that one line at the panel's width, which is
                  the budget the token total and the capture date fell outside
                  of — both are still in src/data/hero-run.json. */}
              <div class="dag-meta">
                <span class="dag-meta-dot"></span>
                <span class="dag-meta-line">{l.hero.runReal}{' · '}<code>runTeam()</code>{' · '}{heroRun.model}{' · '}{heroRun.tasks.length} {l.hero.runTasks}{' · '}<span class="dag-elapsed" data-hero-elapsed>{heroWallS}s</span>{' · '}{l.hero.runIdLabel} <code>{heroRunShort}</code></span>
                <button type="button" class="dag-replay" data-landing-event="hero-replay" data-hero-replay-button aria-label={l.hero.replay} title={l.hero.replay} hidden>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- ── 2. Why OMA: the former control, environment, and capability
           sections condensed into one decision-oriented block. ── -->
      <section class="section home-section" id="reliability">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow"><span class="idx">01</span> {l.sectionWhy.eyebrow}</div>
            <h2 class="section-title">{l.sectionWhy.title}</h2>
            <p class="section-sub">{l.sectionWhy.sub}</p>
          </div>
          <span id="capabilities" class="anchor-target" aria-hidden="true"></span>
          <span id="environment" class="anchor-target" aria-hidden="true"></span>
          <span id="stack" class="anchor-target" aria-hidden="true"></span>
          <div class="why-grid">
            {WHY.map((item, index) => (
              <Card padding="lg" class="why-card">
                <div class="why-card-top">
                  <span class="why-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="why-tag">{item.tag}</span>
                </div>
                <div class="why-title">{item.title}</div>
                <p class="why-desc">{item.desc}</p>
                <code class="why-proof">{item.proof}</code>
                <div class="why-foot"><a class="text-link" href={L(item.ref)}><span>{item.refLabel}</span><span class="arrow">→</span></a></div>
              </Card>
            ))}
          </div>
          <figure class="why-viewer">
            <figcaption class="why-viewer-copy">
              <div class="evidence-label">{l.whyViewer.eyebrow}</div>
