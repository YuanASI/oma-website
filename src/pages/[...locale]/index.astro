    </main>

    <!-- ── Footer — shared component ── -->
    <Footer locale={locale} />

    <script>
      // ── Stats count-up on scroll ──
      // 动画终点优先用客户端实时抓取的 GitHub 数(stars/forks),fetch 失败或
      // 超时则回退到构建期烤进 data-count 的值。因为动画本来就是 0→终点,把
      // 终点换成实时值不会有数字跳变 —— 滚动动画天然掩护了「构建期值 → 实时值」
      // 的差异。无 JS / 抓取失败的访客看到的就是构建期值(合理 fallback)。
      const fmt = (n: number) => Math.round(n).toLocaleString('en-US');

      // fetch 推迟到 window load 之后才发起:模块顶层立即 fetch 会把 api.github.com
      // 拉进 Lighthouse 的关键请求链(实测占 0.9–1.3s 的 max critical path)。stats
      // 区域在首屏之下,用户滚到那里远晚于 load,所以推迟不改变动画体验。
      const afterLoad = (fn: () => void) => {
        if (document.readyState === 'complete') fn();
        else addEventListener('load', () => fn(), { once: true });
      };

      // CTA clicks report to Counterscale — the same first-party, cookieless
      // collector that already counts pageviews (insights.open-multi-agent.com),
      // so the first-step funnel and the traffic it comes from can be read off
      // one dataset. The tag is loaded `defer` from BaseLayout, so the global may
      // not exist yet when an impatient visitor clicks: every hop is optional and
      // the whole call is wrapped, because a measurement miss must never break a
      // CTA. The `oma:landing-event` DOM event stays as the local seam another
      // collector can subscribe to without touching the markup again.
      type CounterscaleGlobal = { trackEvent?: (name: string) => void };
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element
          ? event.target.closest<HTMLElement>('[data-landing-event]')
          : null;
        const name = target?.dataset.landingEvent;
        if (!name) return;
        const detail = { name, locale: document.documentElement.lang || 'en' };
        window.dispatchEvent(new CustomEvent('oma:landing-event', { detail }));
        try {
          (window as typeof window & { Counterscale?: CounterscaleGlobal })
            .Counterscale?.trackEvent?.(name);
        } catch {
          // Analytics is best-effort; a failed report is not the visitor's problem.
        }
      });

      type LiveCounts = { stars: number; forks: number };
      let resolveLive: (v: LiveCounts | null) => void;
      const live: Promise<LiveCounts | null> = new Promise((res) => (resolveLive = res));
      afterLoad(() =>
        fetch('https://api.github.com/repos/open-multi-agent/open-multi-agent', {
          headers: { Accept: 'application/vnd.github+json' },
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((j: any) =>
            resolveLive(
              j && typeof j.stargazers_count === 'number'
                ? { stars: j.stargazers_count, forks: j.forks_count }
                : null,
            ),
          )
          .catch(() => resolveLive(null)),
      );

      // 滚到该区域时实时值还没回来,最多等 800ms(自 fetch 发起时刻起算)就用
      // 构建期值,避免动画卡住。
      const liveOrTimeout: Promise<LiveCounts | null> = Promise.race([
        live,
        new Promise<null>((res) => afterLoad(() => setTimeout(() => res(null), 800))),
      ]);

      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
        const baked = parseInt(el.dataset.count || '0', 10);
        const liveKey = el.dataset.live as keyof LiveCounts | undefined;
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            obs.disconnect();
            liveOrTimeout.then((data) => {
              const fromLive = data && liveKey ? data[liveKey] : undefined;
              const target = typeof fromLive === 'number' && fromLive > 0 ? fromLive : baked;
              const dur = 1100;
              const t0 = performance.now();
              const tick = (now: number) => {
                const p = Math.min(1, (now - t0) / dur);
                const eased = 1 - Math.pow(1 - p, 3);
                el.textContent = fmt(target * eased);
                if (p < 1) requestAnimationFrame(tick);
                else el.textContent = fmt(target);
              };
              requestAnimationFrame(tick);
            });
          });
        }, { threshold: 0.4 });
        io.observe(el);
      });

      // ── FAQ accordion (single-open) ──
      const faqItems = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
      faqItems.forEach((item) => {
        const q = item.querySelector('.faq-q');
        q?.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');
          faqItems.forEach((i) => {
            i.classList.remove('open');
            i.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
            i.querySelector('.faq-a')?.setAttribute('aria-hidden', 'true');
          });
          if (!isOpen) {
            item.classList.add('open');
            q.setAttribute('aria-expanded', 'true');
            item.querySelector('.faq-a')?.setAttribute('aria-hidden', 'false');
          }
        });
      });

      // ── Copy: command blocks ──
      const copyText = async (text: string) => {
        if (!navigator.clipboard?.writeText) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      };

      document.querySelectorAll<HTMLElement>('.cmd').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.dataset.cmd || btn.querySelector('.text')?.textContent || '';
          const feedback = btn.closest('.cmd-wrap')?.querySelector<HTMLElement>('.copy-feedback');
          const ok = await copyText(text);
          btn.classList.toggle('copied', ok);
          btn.classList.toggle('copy-failed', !ok);
          if (feedback) feedback.textContent = ok ? (btn.dataset.copied || '') : (btn.dataset.failed || '');
          setTimeout(() => {
            btn.classList.remove('copied', 'copy-failed');
            if (feedback) feedback.textContent = '';
          }, ok ? 1400 : 2800);
        });
      });

      // ── Copy: code blocks ──
      document.querySelectorAll<HTMLElement>('.ds-codeblock__copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orig = btn.textContent;
          const ok = await copyText(btn.dataset.clip || '');
          const status = btn.parentElement?.querySelector<HTMLElement>('.ds-codeblock__status');
          btn.classList.toggle('copied', ok);
          btn.classList.toggle('copy-failed', !ok);
          btn.textContent = ok ? (btn.dataset.copied || '✓ copied') : (btn.dataset.failed || 'Copy failed');
          if (status) status.textContent = btn.textContent;
          setTimeout(() => {
            btn.classList.remove('copied', 'copy-failed');
            btn.textContent = orig;
            if (status) status.textContent = '';
          }, ok ? 1400 : 2800);
        });
      });

      // ── Lazy video (dashboard demo) ──
      // Sources ship with data-src only; swap in + load when the video nears the
      // viewport (400px margin ≈ in-flight before it scrolls into view). play() is
      // a belt-and-braces nudge — autoplay+muted already covers the normal path.
      document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]').forEach((v) => {
        const io = new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            obs.disconnect();
            v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
              s.src = s.dataset.src || '';
            });
            v.load();
            v.play().catch(() => {});
          });
        }, { rootMargin: '400px' });
        io.observe(v);
      });
    </script>

    <script>
      // ── Hero run-log replay ──
      // Replays the captured run: each row moves queued → running → done on the
      // schedule computed at build time from its own durationMs and dependsOn
      // edges (src/lib/hero-replay.ts), and the wall-clock field in the receipt
      // counts up to the run's real wallMs. No timing is invented here — this
      // code only reads the clock and walks segments the page was served.
      //
      // Progressive enhancement: the rows are served completed, so with JS off,
      // with the panel absent, or under prefers-reduced-motion, the reader sees
      // the finished run and nothing ever moves. The replay button is served
      // hidden and only revealed once this script can honour it.
      type Segment = { id: string; startMs: number; endMs: number };
      type Schedule = { segments: Segment[]; totalMs: number; wallMs: number; targetMs: number };

      const heroPanel = document.querySelector<HTMLElement>('[data-hero-replay]');
      const heroSpec: Schedule | null = (() => {
        try {
          return heroPanel ? (JSON.parse(heroPanel.dataset.heroReplay || 'null') as Schedule) : null;
        } catch {
          return null;
        }
      })();

      if (heroPanel && heroSpec && heroSpec.segments.length > 0 && heroSpec.totalMs > 0) {
        const nodes = new Map<string, HTMLElement[]>();
        heroPanel.querySelectorAll<HTMLElement>('[data-replay-id]').forEach((el) => {
          const key = el.dataset.replayId!;
          // One row per captured task today; kept as a list so a second
          // rendering of the same task (a future mobile variant, say) would be
          // driven by the same schedule rather than silently ignored.
          nodes.set(key, [...(nodes.get(key) ?? []), el]);
        });
        const elapsedEl = heroPanel.querySelector<HTMLElement>('[data-hero-elapsed]');
        const replayButton = heroPanel.querySelector<HTMLButtonElement>('[data-hero-replay-button]');
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
        const seconds = (ms: number) => Math.round(ms / 1000) + 's';

        const paint = (atMs: number) => {
          for (const seg of heroSpec.segments) {
            const state = atMs < seg.startMs ? 'queued' : atMs < seg.endMs ? 'running' : 'done';
            for (const el of nodes.get(seg.id) ?? []) el.dataset.status = state;
          }
          if (elapsedEl) elapsedEl.textContent = seconds(Math.min(atMs, heroSpec.wallMs));
        };
        const settle = () => paint(heroSpec.totalMs);

        let frame = 0;
        const play = () => {
          cancelAnimationFrame(frame);
          if (reduceMotion.matches) {
            settle();
            return;
          }
          // Captured milliseconds per real millisecond: a two-minute run reads
          // in about targetMs (4s) without any duration being restated.
          const speed = heroSpec.totalMs / heroSpec.targetMs;
          const started = performance.now();
          const step = (now: number) => {
            const at = Math.min((now - started) * speed, heroSpec.totalMs);
            paint(at);
            if (at < heroSpec.totalMs) frame = requestAnimationFrame(step);
            else settle();
          };
          frame = requestAnimationFrame(step);
        };

        if (!reduceMotion.matches) {
          if (replayButton) {
            replayButton.hidden = false;
            replayButton.addEventListener('click', play);
          }
          // Play once when the panel is actually on screen. The hero is above
          // the fold, so in practice this fires immediately; the observer only
          // stops the run from being spent while the tab is scrolled elsewhere.
          const io = new IntersectionObserver((entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              obs.disconnect();
              play();
            }
          }, { threshold: 0.25 });
          io.observe(heroPanel);
        }

        // A reader who turns reduced motion on mid-visit gets the final state,
        // not a frozen half-finished DAG.
        reduceMotion.addEventListener('change', () => {
          if (!reduceMotion.matches) return;
          cancelAnimationFrame(frame);
          settle();
          if (replayButton) replayButton.hidden = true;
        });
      }
    </script>
</BaseLayout>
