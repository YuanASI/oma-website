---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/tokens.css';
import '../../styles/landing.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { REPO, ghStats } from '../../lib/site';
import { AUTHOR, articleDates, publisher } from '../../lib/schema';
import { localeStaticPaths, localizePath, toLocale, useTranslations } from '../../i18n';

export function getStaticPaths() { return localeStaticPaths(); }
const locale = toLocale(Astro.params.locale);
const t = useTranslations(locale);
const c = t.capabilitiesPage;
const L = (path: string) => localizePath(path, locale);
const stats = await ghStats();
const starsK = (stats.stars / 1000).toFixed(1) + 'k';
const heroTitle = c.hero.title.join(locale === 'zh' ? '' : ' ');

const groupHrefs = [
  '/reference/execution-routing/',
  '/reference/task-scheduling/',
  '/guides/orchestration-controls/',
  '/reference/checkpoint/',
  '/reference/observability/',
  '/integrations/',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
  headline: c.seo.title,
  description: c.seo.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...articleDates('/capabilities/'),
  author: AUTHOR,
  publisher: publisher(Astro.site),
  isPartOf: { '@type': 'WebSite', name: 'Open Multi-Agent', url: 'https://open-multi-agent.com' },
};
---

<BaseLayout locale={locale} title={c.seo.title} description={c.seo.description} jsonLd={jsonLd} path="/capabilities/">
  <Nav current="capabilities" starsK={starsK} locale={locale} path="/capabilities/" />

  <main>
    <header class="cap-hero">
      <div class="container">
        <div class="eyebrow"><span class="idx">//</span> {c.hero.eyebrow}</div>

        <div class="cap-hero-title-row">
          <h1>{c.hero.title.map((line) => <span>{line}</span>)}</h1>
          <div class="cap-actions">
            <a class="btn-primary" href={L('/getting-started/quick-start/')}><span>{c.hero.quickStart}</span><span class="arrow">→</span></a>
            <a class="text-link" href={`${REPO}/releases/tag/v1.13.0`} target="_blank" rel="noreferrer"><span>{c.hero.releaseNotes}</span><span class="arrow">↗</span></a>
          </div>
        </div>

        <div class="cap-hero-copy">
          <p>{c.hero.lede}</p>
          <div class="release-stamp">
            <span class="release-dot"></span>
            <span>{c.hero.release}</span>
          </div>
        </div>

        <ol class="runtime-flow" aria-label={heroTitle}>
          {c.flow.map((step) => (
            <li>
              <div class="runtime-flow-head"><span>{step.n}</span><b>{step.tag}</b></div>
              <h2>{step.title}</h2>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </header>

    <section class="section cap-surface">
      <div class="container">
        <div class="section-head">
          <div class="eyebrow"><span class="idx">01</span> {c.section.eyebrow}</div>
          <h2 class="section-title">{c.section.title}</h2>
          <p class="section-sub">{c.section.lede}</p>
        </div>

        <div class="capability-groups">
          {c.groups.map((group, index) => (
            <article class="capability-group">
              <div class="capability-group-index">{String(index + 1).padStart(2, '0')}</div>
              <div class="capability-group-copy">
                <div class="capability-group-tag">{group.tag}</div>
                <h3>{group.title}</h3>
                <p>{group.body}</p>
                <code>{group.proof}</code>
                <a class="text-link" href={L(groupHrefs[index])}><span>{group.link}</span><span class="arrow">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section cap-boundary">
      <div class="container">
        <div class="boundary-panel">
          <div class="boundary-intro">
            <div class="eyebrow"><span class="idx">02</span> {c.boundary.eyebrow}</div>
            <h2>{c.boundary.title}</h2>
            <p>{c.boundary.body}</p>
          </div>
          <dl>
            {c.boundary.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container cta-final">
        <div class="eyebrow" style="justify-content:center;"><span class="idx">03</span> {c.cta.eyebrow}</div>
        <h2>{c.cta.title}</h2>
        <div class="cta-actions">
          <a class="btn-primary" href={L('/getting-started/quick-start/')}><span>{c.cta.quickStart}</span><span class="arrow">→</span></a>
          <a class="text-link" href={L('/architecture/')}><span>{c.cta.architecture}</span><span class="arrow">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .cap-hero {
    padding: var(--space-16) 0 var(--space-12);
    background: var(--oma-bg-0);
  }
  .cap-hero > .container > .eyebrow { margin-bottom: 0; }
  .cap-hero-title-row {
    display: grid; grid-template-columns: minmax(0, 820px) auto;
    align-items: center; justify-content: space-between; gap: 48px;
    margin-top: 18px;
  }
  .cap-hero h1 {
    max-width: 820px; margin: 0;
    font-family: var(--font-sans); font-weight: 600;
    font-size: clamp(42px, 7vw, 76px); line-height: 0.98;
    letter-spacing: -0.055em; color: var(--oma-fg-0);
  }
  .cap-hero h1 > span { display: block; }
  .cap-hero-copy {
    display: grid; grid-template-columns: minmax(0, 720px) auto;
    align-items: start; justify-content: space-between; gap: 48px;
    margin-top: 24px;
  }
  .cap-hero-copy p {
    max-width: 720px; margin: 0;
    font-size: 17px; line-height: 1.7; color: var(--oma-fg-1);
  }
  .cap-actions {
    display: flex; flex-direction: column; align-items: flex-start; gap: 20px;
  }
  .release-stamp {
    display: flex; align-items: center; gap: 9px;
    padding: 10px 12px; border: 1px solid var(--oma-border-1);
    border-radius: var(--radius-sm); background: var(--oma-bg-1);
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--oma-fg-2); white-space: nowrap;
  }
  .release-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--oma-accent); box-shadow: 0 0 0 4px var(--oma-accent-soft);
  }
  .runtime-flow {
    list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 64px 0 0; padding: 0;
    border: 1px solid var(--oma-border-1); border-radius: var(--radius-md);
    background: var(--oma-bg-1); overflow: hidden;
  }
  .runtime-flow li {
    position: relative; min-width: 0; padding: 18px;
    border-left: 1px solid var(--oma-border-0);
  }
  .runtime-flow li:first-child { border-left: 0; }
  .runtime-flow li:not(:last-child)::after {
    content: '→'; position: absolute; z-index: 1; top: 18px; right: -8px;
    display: grid; place-items: center; width: 16px; height: 16px;
    background: var(--oma-bg-1); color: var(--oma-accent);
    font-family: var(--font-mono); font-size: 11px;
  }
  .runtime-flow-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .runtime-flow-head span, .runtime-flow-head b {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .runtime-flow-head span { color: var(--oma-accent); }
  .runtime-flow-head b { color: var(--oma-fg-3); font-weight: 600; }
  .runtime-flow h2 { margin: 22px 0 0; font-size: 17px; line-height: 1.25; color: var(--oma-fg-0); }
  .runtime-flow p { margin: 9px 0 0; font-size: 12.5px; line-height: 1.55; color: var(--oma-fg-2); }
  .capability-groups {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--oma-border-1); border-left: 1px solid var(--oma-border-1);
  }
  .capability-group {
    display: grid; grid-template-columns: 52px minmax(0, 1fr);
    min-width: 0; min-height: 330px;
    border-right: 1px solid var(--oma-border-1);
    border-bottom: 1px solid var(--oma-border-1);
    background: var(--oma-bg-1);
  }
  .capability-group-index {
    padding: 22px 14px; border-right: 1px solid var(--oma-border-0);
    font-family: var(--font-mono); font-size: 11px; color: var(--oma-accent);
  }
  .capability-group-copy { display: flex; flex-direction: column; padding: 26px; min-width: 0; }
  .capability-group-tag {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.09em;
    text-transform: uppercase; color: var(--oma-fg-3);
  }
  .capability-group h3 {
    margin: 16px 0 0; font-size: 25px; line-height: 1.1;
    letter-spacing: -0.03em; color: var(--oma-fg-0);
  }
  .capability-group p { margin: 15px 0 0; font-size: 14px; line-height: 1.7; color: var(--oma-fg-1); }
  .capability-group code {
    display: block; margin: 20px 0 0; padding-top: 16px;
    border-top: 1px solid var(--oma-border-0);
    font-family: var(--font-mono); font-size: 11px; line-height: 1.6;
    color: var(--code-string); overflow-wrap: anywhere;
  }
  .capability-group .text-link { margin-top: auto; padding-top: 22px; }
  .cap-boundary { padding-top: 0; }
  .boundary-panel {
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    border: 1px solid var(--oma-border-1); border-radius: var(--radius-md);
    background: var(--oma-bg-1); overflow: hidden;
  }
  .boundary-intro { padding: 32px; border-right: 1px solid var(--oma-border-1); }
  .boundary-intro h2 { margin: 18px 0 0; font-size: 30px; line-height: 1.1; letter-spacing: -0.035em; }
  .boundary-intro p { margin: 16px 0 0; font-size: 14px; line-height: 1.7; color: var(--oma-fg-1); }
  .boundary-panel dl { margin: 0; }
  .boundary-panel dl > div {
    display: grid; grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px; padding: 24px 28px; border-top: 1px solid var(--oma-border-0);
  }
  .boundary-panel dl > div:first-child { border-top: 0; }
  .boundary-panel dt {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--oma-accent);
  }
  .boundary-panel dd { margin: 0; font-size: 13.5px; line-height: 1.65; color: var(--oma-fg-1); }
  @media (max-width: 980px) {
    .runtime-flow { grid-template-columns: 1fr; }
    .runtime-flow li { border-left: 0; border-top: 1px solid var(--oma-border-0); }
    .runtime-flow li:first-child { border-top: 0; }
    .runtime-flow li:not(:last-child)::after { content: '↓'; top: auto; bottom: -8px; right: 18px; }
  }
  @media (max-width: 760px) {
    .cap-hero { padding-top: var(--space-12); }
    .cap-hero h1 { font-size: clamp(32px, 9vw, 38px); }
    :global(html[lang='zh-CN']) .cap-hero h1 { font-size: clamp(29px, 8.5vw, 35px); }
    .cap-hero-title-row { grid-template-columns: 1fr; gap: 28px; }
    .cap-hero-copy { grid-template-columns: 1fr; gap: 28px; }
    .cap-actions { gap: 18px; }
    .runtime-flow { margin-top: 42px; }
    .capability-groups { grid-template-columns: 1fr; }
    .capability-group { min-height: 0; }
    .boundary-panel { grid-template-columns: 1fr; }
    .boundary-intro { border-right: 0; border-bottom: 1px solid var(--oma-border-1); }
    .boundary-panel dl > div { grid-template-columns: 1fr; gap: 9px; }
  }
</style>
